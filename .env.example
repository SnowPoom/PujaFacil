# Variables de entorno — PujaFácil
# Copia este archivo como .env y completa los valores locales.
# NUNCA subas .env al repositorio.

# --- Base de datos ---
# Cadena de ejemplo local; no usar con datos reales
DATABASE_URL="postgresql://pujafacil:pujafacil_dev@localhost:5432/pujafacil?schema=public"

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- HTTPS/WSS opcional (dejar vacíos para HTTP local) ---
# Si configuras uno, debes configurar AMBOS.
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# --- Sesión ---
SESSION_COOKIE_NAME=pf_session

# --- Cifrado de cédula AES-256-GCM ---
# Genera localmente con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY_HEX=REEMPLAZAR_CON_64_HEX_ALEATORIOS

# --- Semilla de demostración ---
# Contraseña para los usuarios ficticios del seed; solo entorno local.
DEMO_PASSWORD=DEFINIR_SOLO_EN_ENTORNO_LOCAL

# Recuperación académica sin SMTP: habilitar explícitamente en producción local.
# En desarrollo el enlace ya aparece en la terminal.
PASSWORD_RESET_DELIVERY=console
